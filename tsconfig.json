{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
  },
  // Validamos el archivo de Vite aquí
  "include": ["vite.config.ts", "pwa.config.ts"],
  // Apuntamos a los sub-proyectos
  "references": [
    { "path": "./tsconfig.client.json" },
    { "path": "./tsconfig.server.json" }
  ]
}