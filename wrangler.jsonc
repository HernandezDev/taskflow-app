{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taskflow-app",
	"compatibility_date": "2026-06-20",
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
        "binding": "DB", 
        "database_name": "taskflow-db",
        "database_id": "1aae459c-c8e4-4726-bdd2-f20dfefcdd47",
        "migrations_dir": "drizzle"
    	}
	],
	"vars": {
        "FRONTEND_URL": "https://taskflow-app-1au.pages.dev"
    }
