{
	"name": "taskflow-app",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --mode server",
		"preview": "wrangler pages dev dist",
		"deploy": "pnpm run build && wrangler pages deploy",
		"logs:preview": "wrangler pages deployment tail --project-name taskflow-app --environment preview --format json",
		"logs:prod": "wrangler pages deployment tail --project-name taskflow-app --environment production --format json",
		"docs:erd": "tsx scripts/docs.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@internationalized/date": "^3.12.2",
		"@phosphor-icons/react": "^2.1.10",
		"@preact/signals": "^2.9.2",
		"@preact/signals-core": "^1.14.3",
		"@zag-js/date-picker": "^1.42.0",
		"@zag-js/editable": "^1.42.0",
		"@zag-js/preact": "^1.42.0",
		"@zag-js/radio-group": "^1.42.0",
		"better-auth": "^1.6.20",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.26",
		"preact": "^10.29.2",
		"preact-iso": "^2.12.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@cloudflare/workers-types": "^4.20260619.1",
		"@hono/vite-build": "^1.11.1",
		"@hono/vite-dev-server": "^0.26.0",
		"@preact/preset-vite": "^2.10.5",
		"@tailwindcss/vite": "^4.3.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-mermaid-generator": "^0.0.5",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"wrangler": "^4.4.0"
	}
}
